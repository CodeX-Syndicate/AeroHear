<Window x:Class="AeroHear.BeepTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test de Délai" Height="150" Width="380" WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid Margin="15">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Test de délai en cours..." FontWeight="Bold" FontSize="16" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <TextBlock Text="Ajustez les délais dans la fenêtre principale jusqu'à entendre un seul bip synchronisé." TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,0,0,10"/>
        </StackPanel>
    </Grid>
</Window>
